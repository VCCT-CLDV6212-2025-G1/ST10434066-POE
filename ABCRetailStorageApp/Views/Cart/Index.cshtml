@model List<ABCRetailStorageApp.Models.OrderItem>

    @{
    ViewData["Title"] = "My Cart";
    var total = ViewBag.Total as decimal? ?? 0m;
    }

    <h2>My Cart</h2>

    @if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

    @if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@item.LineTotal.ToString("C")</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total:</th>
                <th>@total.ToString("C")</th>
            </tr>
        </tfoot>
    </table>

    <a class="btn btn-primary" asp-action="Checkout">Proceed to Checkout</a>
}
