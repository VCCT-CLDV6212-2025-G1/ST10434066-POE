@model List<ABCRetailStorageApp.Models.OrderItem>

    @{
    ViewData["Title"] = "Checkout";
    var total = ViewBag.Total as decimal? ?? 0m;
    }

    <h2>Checkout</h2>

    <p>Please confirm your order:</p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
    {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@item.LineTotal.ToString("C")</td>
            </tr>
    }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total:</th>
                <th>@total.ToString("C")</th>
            </tr>
        </tfoot>
    </table>

    <form asp-action="Confirm" method="post">
        <button type="submit" class="btn btn-success">Confirm Order</button>
        <a asp-action="Index" class="btn btn-secondary">Back to Cart</a>
    </form>
