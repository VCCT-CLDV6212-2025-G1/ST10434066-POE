@model List<string>
@{
    ViewData["Title"] = "Contracts";
}
<h2>Contracts</h2>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div class="mb-2"><input type="file" name="file" class="form-control" /></div>
    <button class="btn btn-primary">Upload</button>
</form>

<form asp-action="Seed" method="post" class="mt-2">
    <button class="btn btn-dark">Seed 5 Dummy Contracts</button>
</form>

<p class="mt-3">Total files: <strong>@ViewBag.Count</strong></p>

<table class="table table-striped">
    <thead><tr><th>File name</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n</td>
                <td><a asp-action="Download" asp-route-name="@n" class="btn btn-link">Download</a></td>
            </tr>
        }
    </tbody>
</table>